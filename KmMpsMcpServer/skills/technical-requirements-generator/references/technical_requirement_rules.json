{
  "version": "v1-draft",
  "notes": [
    "这是首版结构化草稿，优先覆盖当前样例中最常见且最稳定的规则。",
    "复杂动态文本、特种表面处理和少量样例中未完全稳定的工序，后续可继续补充。",
    "条件字段采用通用路径表达，执行器可按路径读取 part_context 和 route_input。",
    "新增 required_context 和 skip_if_unknown，用于支持 CAD-only / 可选人工补充 / 上游直供上下文 三种模式。"
  ],
  "rule_meta_schema": {
    "required_context": {
      "description": "列出该规则判断前必须知道的上下文字段。",
      "examples": [
        "material.grade",
        "part.part_class",
        "features.side_a.inner_groove.exists"
      ]
    },
    "skip_if_unknown": {
      "description": "当 required_context 中任一字段未知时的处理策略。",
      "allowed_values": ["true", "false"],
      "meaning": {
        "true": "字段未知则直接跳过该规则",
        "false": "字段未知也允许继续判断"
      }
    },
    "completeness_tier": {
      "description": "规则所需上下文完整度级别。",
      "allowed_values": ["cad_only", "part_class_required", "material_required", "advanced_process_required"]
    }
  },
