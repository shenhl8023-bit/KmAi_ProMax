{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kmsoft.local/schemas/select_group_template.confirm.response.schema.json",
  "title": "SelectGroupTemplateConfirmResponse",
  "type": "object",
  "required": [
    "ok",
    "action",
    "stage",
    "mode",
    "workflow",
    "selectedTemplate",
    "draft",
    "xml",
    "structureSummary",
    "handoff"
  ],
  "additionalProperties": true,
  "properties": {
    "ok": {
      "type": "boolean"
    },
    "action": {
      "const": "confirm"
    },
    "stage": {
      "const": "select_group_template"
    },
    "mode": {
      "const": "completed"
    },
    "reply": {
      "type": "string"
    },
    "workflow": {
      "$ref": "#/$defs/workflow"
    },
    "selectedTemplate": {
      "$ref": "#/$defs/template"
    },
    "draft": {
      "type": "object"
    },
    "xml": {
      "type": "string"
    },
    "structureSummary": {
      "type": "string"
    },
    "handoff": {
      "$ref": "#/$defs/handoff"
    }
  },
  "$defs": {
    "workflow": {
      "type": "object",
      "required": [
        "currentStep",
        "steps"
      ],
      "properties": {
        "currentStep": {
          "const": "select_group_template"
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "title",
              "status"
            ],
            "properties": {
              "id": {
                "const": "select_group_template"
              },
              "title": {
                "const": "选择分组模板"
              },
              "status": {
                "const": "completed"
              }
            }
          }
        }
      }
    },
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "templateId",
        "filename",
        "displayName",
        "relativePath",
        "groupCount",
        "depth"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "templateId": {
          "type": "string"
        },
        "filename": {
          "type": "string"
        },
        "displayName": {
          "type": "string"
        },
        "relativePath": {
          "type": "string"
        },
        "groupCount": {
          "type": "integer"
        },
        "depth": {
          "type": "integer"
        }
      }
    },
    "handoff": {
      "type": "object",
      "required": [
        "step",
        "completed",
        "selectedGroupTemplate",
        "draft",
        "xml",
        "structureSummary"
      ],
      "properties": {
        "step": {
          "const": "select_group_template"
        },
        "completed": {
          "const": true
        },
        "selectedGroupTemplate": {
          "$ref": "#/$defs/handoffTemplate"
        },
        "draft": {
          "type": "object"
        },
        "xml": {
          "type": "string"
        },
        "structureSummary": {
          "type": "string"
        }
      }
    },
    "handoffTemplate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "displayName",
        "filename",
        "relativePath"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "displayName": {
          "type": "string"
        },
        "filename": {
          "type": "string"
        },
        "relativePath": {
          "type": "string"
        }
      }
    }
  }
}
