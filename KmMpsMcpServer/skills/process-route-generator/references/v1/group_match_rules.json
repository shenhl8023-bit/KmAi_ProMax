  "output_policy": {
    "keep_only_positive_scores": true,
    "restrict_to_context_prefix_first": true,
    "keep_all_top_ties": true,
    "show_matched_features_first": true,
    "fallback_to_group_features_when_no_direct_feature_hit": true,
    "skip_auxiliary_processes": true
  }
}
