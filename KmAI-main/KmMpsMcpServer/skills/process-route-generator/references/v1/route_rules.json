{
  "schema_version": "1.0",
  "dataset_id": "process-route-rules-v1",
  "dataset_name": "工艺路线规则",
  "description": "根据完整因素表从全集工艺路线中命中具体工序。当前内容由样例中的 rules.json 转换而来。",
  "rules": [
    {
      "rule_id": "R001",
      "enabled": true,
      "priority": 100,
      "when": {
        "all": [
          {
            "factor_key": "material_grade",
            "op": "=",
            "value": "9Cr18"
          }
        ]
      },
      "then": {
        "include_process_keys": ["quench_and_temper"]
      },
      "confidence": "high",
      "note": "9Cr18 当前样例默认命中调质。"
    },
    {
      "rule_id": "R002",
      "enabled": true,
      "priority": 100,
      "when": {
        "all": [
          {
            "factor_key": "material_grade",
            "op": "=",
            "value": "4Cr14Ni14W2Mo"
          }
        ]
      },
      "then": {
        "include_process_keys": ["normalizing"]
      },
      "confidence": "medium",
      "note": "4Cr14Ni14W2Mo 当前样例命中正常化。"
    },
    {
      "rule_id": "R003",
