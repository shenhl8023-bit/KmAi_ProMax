diff --git a/KmRuntime.h b/KmRuntime.h
new file mode 100644
index 0000000..054bda6
--- /dev/null
+++ b/KmRuntime.h
@@ -0,0 +1,71 @@
+#ifndef KM_RUNTIME_H
+#define KM_RUNTIME_H
+
+#include <QCoreApplication>
+#include <QDir>
+#include <QFileInfo>
+#include <QSettings>
+#include <QStringList>
+#include <QUrl>
+
+namespace KmRuntime {
+inline bool hasPackageFiles(const QString& root)
+{
+    const QDir package(root);
+    return QFileInfo(package.filePath("runtime/python.exe")).isFile()
+        && QFileInfo(package.filePath("launcher.py")).isFile();
+}
+
+inline QString packageRoot()
+{
+    const QString configured = qEnvironmentVariable("KMAI_PACKAGE_ROOT").trimmed();
+    if (!configured.isEmpty() && hasPackageFiles(configured))
+        return QDir::cleanPath(QDir(configured).absolutePath());
+
+    const QString applicationDir = QDir::cleanPath(QCoreApplication::applicationDirPath());
+    const QStringList candidates = {
+        applicationDir,
+        QDir(applicationDir).filePath("KmAI"),
+        QDir::cleanPath(QDir(applicationDir).filePath("..")),
+        QDir::cleanPath(QDir(applicationDir).filePath("../KmAI")),
+    };
+    for (const QString& candidate : candidates) {
+        if (hasPackageFiles(candidate))
+            return QDir::cleanPath(QDir(candidate).absolutePath());
+    }
+    // 找不到完整包时保留历史 CefView/KmAiChatCef.exe 布局，便于输出明确的缺失文件日志。
+    return QDir::cleanPath(QDir(applicationDir).filePath(".."));
+}
+
+inline QString stateRoot()
+{
+    const QString configured = qEnvironmentVariable("KMAI_RUNTIME_DIR").trimmed();
+    if (!configured.isEmpty())
+        return QDir(configured).absolutePath();
+    const QString local = qEnvironmentVariable("LOCALAPPDATA").trimmed();
+    if (!local.isEmpty())
+        return QDir(local).filePath("KmAI");
+    const QString temp = qEnvironmentVariable("TEMP").trimmed();
+    if (!temp.isEmpty())
+        return QDir(temp).filePath("KmAI");
+    const QString tmp = qEnvironmentVariable("TMP").trimmed();
+    if (!tmp.isEmpty())
+        return QDir(tmp).filePath("KmAI");
+    const QString profile = qEnvironmentVariable("USERPROFILE").trimmed();
+    return profile.isEmpty() ? QString()
+        : QDir(profile).filePath("AppData/Local/KmAI");
+}
+
+inline QString webUrl()
+{
+    QSettings settings(QDir(packageRoot()).filePath("config.ini"), QSettings::IniFormat);
+    settings.setIniCodec("UTF-8");
+    const QUrl url(settings.value("WebView/url", "http://127.0.0.1:9095/").toString());
+    // 包内启动器只负责本机回环地址的 HTTP Agent。
+    if (!url.isValid() || url.scheme() != "http" || url.host() != "127.0.0.1"
+        || !url.userInfo().isEmpty() || url.port(80) < 1 || url.port(80) > 65535)
+        return QString();
+    return url.toString();
+}
+}
+#endif
